# ==============================================================================
# Agentic Telephony Configuration (.env)
# ==============================================================================

# Telephony Engine Selection ("vapi" or "retell")
TELEPHONY_PROVIDER=vapi

# ------------------------------------------------------------------------------
# Vapi AI Configuration (https://vapi.ai)
# ------------------------------------------------------------------------------
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_VOICE_ID=Sagar
VAPI_VOICE_PROVIDER=vapi
VAPI_LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Retell AI Configuration (https://retellai.com)
# ------------------------------------------------------------------------------
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_FROM_NUMBER=your_retell_purchased_phone_number_here

# ------------------------------------------------------------------------------
# Caller & Persona Defaults
# ------------------------------------------------------------------------------
CALLER_NAME=Alex
CALLER_PHONE=+15551234567
DEFAULT_LOCATION=Dallas, TX

# ------------------------------------------------------------------------------
# Webhook Server for Inbound Calls & Live Transcripts
# ------------------------------------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_URL=https://your-domain.ngrok-free.app/webhook/vapi
